#!/usr/bin/env bash
#
# duckdb-harbor — run a DuckDB database as an HTTP /sql service.
#
#   bin/duckdb-harbor mydata.db                    serve on 127.0.0.1:9495
#   bin/duckdb-harbor mydata.db --port 9600        pick the port
#   bin/duckdb-harbor mydata.db --bind 0.0.0.0     listen beyond loopback
#   bin/duckdb-harbor mydata.db --token secret     set the bearer token
#   bin/duckdb-harbor mydata.db --checkpoint 16MB  raise the WAL checkpoint threshold
#   bin/duckdb-harbor mydata.db --wait             block instead of prompting
#   bin/duckdb-harbor mydata.db --dark-mode        for a prompt that ignores you
#   bin/duckdb-harbor mydata.db --extension ./harbor.duckdb_extension
#
# With no --token, harbor mints one and prints it at startup; that is the only
# time it is shown. HARBOR_TOKEN is honoured if set.
#
# At a terminal this is a normal DuckDB shell that happens to be serving HTTP:
# you get a prompt, and leaving it stops the server and folds the WAL. Piped,
# redirected, or under a supervisor -- anywhere stdin is not a terminal -- it
# blocks on harbor_wait instead, because a service whose stdin is /dev/null
# would otherwise read EOF and exit a millisecond after it started.
#
# --repl and --wait force one or the other. --wait is worth writing explicitly
# in a unit file even though it is already the default there: it says the
# blocking is intended rather than incidental.
#
# The extension is looked for beside this script, then in a built tree, then in
# ~/.duckdb/extensions. Running a downloaded release build needs no source tree
# at all: point --extension at it, or set HARBOR_EXTENSION.
#
# checkpoint_threshold defaults to 1MB here rather than DuckDB's 16MB. This
# launcher serves one database to a long-lived server, and at 16MB a modest
# writer can run for weeks with every committed row sitting in the WAL while
# the .duckdb file stays near-empty. One hard kill, or one WAL that fails to
# replay, and the data is gone — which has happened. Pass --checkpoint 16MB to
# restore DuckDB's default for bulk-load work, where frequent checkpoints cost
# throughput.
#
# The process runs in the foreground and holds the terminal, because that is
# what launchd, systemd, Docker, and a shell job all want. Background it with
# & or hand it to a supervisor. SIGTERM and Ctrl-C drain in-flight requests
# and CHECKPOINT before exiting, so the next open never replays a WAL.
#
# At the prompt, .quit and Ctrl-D both leave. Ctrl-C does not: DuckDB's shell
# takes it as "cancel this line" and prints a fresh prompt.
#
# If the prompt appears and then ignores everything -- Enter gives blank lines,
# Ctrl-C and Ctrl-D do nothing -- that is DuckDB's shell waiting on a terminal
# that has not answered its background-colour query. It gives up after five
# seconds; --dark-mode or --light-mode skips the query and the wait. A stall
# that outlasts that is something else.

set -euo pipefail

mydir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
here=$(cd -- "$mydir/.." && pwd)

# Nothing here needs a build tree. A downloaded release artifact sitting beside
# the script, or named through --extension / HARBOR_EXTENSION, works the same
# way: compiling is one way to obtain the file, not a requirement for using it.
ext="${HARBOR_EXTENSION:-}"

db=""
bind="127.0.0.1"
port="9495"
token="${HARBOR_TOKEN:-}"
workers=""
checkpoint="1MB"
mode=""   # "" = decide from whether stdin is a terminal; see below
colormode=""

# Every flag takes a value, so say so rather than letting `set -u` abort with
# bash's own "$2: unbound variable" — that reads like a bug in this script.
need() {
  [[ $# -ge 2 ]] || { echo "duckdb-harbor: $1 needs a value" >&2; exit 2; }
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --bind)       need "$@"; bind="$2"; shift 2 ;;
    --port)       need "$@"; port="$2"; shift 2 ;;
    --token)      need "$@"; token="$2"; shift 2 ;;
    --workers)    need "$@"; workers="$2"; shift 2 ;;
    --checkpoint) need "$@"; checkpoint="$2"; shift 2 ;;
    --extension)  need "$@"; ext="$2"; shift 2 ;;
    --repl)       mode=repl; shift ;;
    --wait)       mode=wait; shift ;;
    --dark-mode|--light-mode)
                  colormode="${1#-}"; shift ;;
    -h|--help) sed -n '3,32p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0 ;;
    --)        shift; [[ $# -eq 1 ]] || { echo "duckdb-harbor: expected one database path after --" >&2; exit 2; }
               db="$1"; shift ;;
    -*)        echo "duckdb-harbor: unknown option $1" >&2; exit 2 ;;
    # Silently keeping the last of several paths means `duckdb-harbor prod.db
    # staging.db` serves staging and says nothing about it.
    *)         [[ -z "$db" ]] || { echo "duckdb-harbor: more than one database given ($db, $1)" >&2; exit 2; }
               db="$1"; shift ;;
  esac
done

if [[ -z "$db" ]]; then
  echo "usage: duckdb-harbor <database.db> [--bind HOST] [--port N] [--token T] [--workers N] [--checkpoint SIZE] [--extension PATH] [--repl|--wait]" >&2
  exit 2
fi

# port and workers land in the SQL unquoted, because they are numbers there and
# quoting them would make them strings. That makes validating them here the only
# thing standing between a config value and arbitrary SQL: --workers '2); DROP
# TABLE sites; CALL harbor_stop(' used to reach DuckDB as three statements and
# run all of them. Anything a wrapper might forward — a systemd unit, a Helm
# value, a CI matrix entry — arrives through exactly this path.
[[ "$port" =~ ^[0-9]+$ ]] && (( port >= 1 && port <= 65535 )) || {
  echo "duckdb-harbor: --port must be a number from 1 to 65535, got '$port'" >&2; exit 2; }
if [[ -n "$workers" ]]; then
  [[ "$workers" =~ ^[0-9]+$ ]] && (( workers >= 1 )) || {
    echo "duckdb-harbor: --workers must be a positive number, got '$workers'" >&2; exit 2; }
fi

# A path that is not there is not an empty database to be created. duckdb makes
# one silently, so a typo'd path or a volume that failed to mount comes up
# healthy and serves nothing at all.
if [[ ! -e "$db" ]]; then
  echo "duckdb-harbor: no database at $db" >&2
  echo "  (create it first: duckdb '$db' -c 'CHECKPOINT')" >&2
  exit 1
fi

if [[ -z "$ext" ]]; then
  # $mydir -- the script's own directory -- and not just $here, its parent.
  # Unzipping a release beside the downloaded launcher is the documented
  # install, and in that layout $here is one directory too high: it used to look
  # everywhere except where the file actually was, and report that no extension
  # existed. A source tree is covered by build/release below.
  for candidate in \
    "$mydir/harbor.duckdb_extension" \
    "$here/harbor.duckdb_extension" \
    "$here/build/release/harbor.duckdb_extension" \
    "$HOME/.duckdb/extensions/harbor.duckdb_extension"
  do
    [[ -f "$candidate" ]] && { ext="$candidate"; break; }
  done
fi

if [[ -z "$ext" || ! -f "$ext" ]]; then
  echo "duckdb-harbor: no harbor.duckdb_extension found" >&2
  echo "  download one for your platform from the releases page and pass" >&2
  echo "  --extension /path/to/harbor.duckdb_extension (or set HARBOR_EXTENSION)," >&2
  echo "  or build one here with 'make release'" >&2
  exit 1
fi

# DuckDB derives the init symbol from the file name, taking everything before
# the first dot: loading `harbor-v0.7.0-osx_arm64.duckdb_extension` makes it
# look for `harbor-v0_init_c_api`, which does not exist, and the load fails with
# a dlsym error that says nothing about the real cause. The file has to be named
# exactly harbor.duckdb_extension. Rather than make that the user's problem --
# a release asset has to carry its platform in the name to be distinguishable --
# link it under the right name in a per-user staging directory and load that.
# One stable directory, one link, replaced each run, so nothing accumulates.
if [[ "$(basename -- "$ext")" != "harbor.duckdb_extension" ]]; then
  staging="${TMPDIR:-/tmp}/duckdb-harbor-ext.$(id -u)"
  mkdir -p "$staging" || { echo "duckdb-harbor: cannot create $staging" >&2; exit 1; }
  abs_ext=$(cd -- "$(dirname -- "$ext")" && pwd)/$(basename -- "$ext")
  ln -sf "$abs_ext" "$staging/harbor.duckdb_extension"
  ext="$staging/harbor.duckdb_extension"
fi

if ! command -v duckdb >/dev/null 2>&1; then
  echo "harbor: no duckdb on PATH" >&2
  exit 1
fi

# Quote-double every value that goes into SQL as a string: a token with a quote
# in it should be a token, not a syntax error. port and workers are validated
# above instead, because they go in as numbers.
args="bind := '${bind//\'/\'\'}', port := $port"
[[ -n "$token"   ]] && args="$args, token := '${token//\'/\'\'}'"
[[ -n "$workers" ]] && args="$args, workers := $workers"

# -unsigned is required: harbor is not signed by DuckDB's extension registry.
#
# -no-init keeps ~/.duckdbrc out of the served process. An rc that ATTACHes a
# database or sets memory_limit would otherwise change what this service serves,
# on one machine and not another, with nothing in the logs to say so.
#
setup="
  SET checkpoint_threshold = '${checkpoint//\'/\'\'}';
  LOAD '${ext//\'/\'\'}';
  CALL harbor_serve($args);
"

# Which mode, when neither --repl nor --wait said so: a prompt is only useful to
# something that can type, and blocking forever is only useful to something that
# cannot. `[[ -t 0 ]]` is that question. Guessing wrong is bad in both
# directions -- a supervisor handed a prompt reads EOF from /dev/null and the
# "service" is gone a millisecond after it started, and a person handed
# harbor_wait gets a terminal that ignores them.
if [[ -z "$mode" ]]; then
  if [[ -t 0 ]]; then mode=repl; else mode=wait; fi
fi

# repl: serve, then hand the terminal to DuckDB's own prompt. -cmd runs the
# setup before stdin is read and then falls through to the shell, where -c would
# run it and exit; harbor_wait is deliberately absent, since the whole point is
# not to block.
#
# The checkpoint has to happen in a second process, after this one is gone.
# harbor's workers hold pooled connections for as long as the server is up, and
# DuckDB will not checkpoint past an open connection, so closing the shell with
# the server still running leaves committed rows in the WAL -- measured on exit
# from a session that had served one INSERT, not assumed. CALL harbor_stop()
# from the prompt drains the workers and folds the WAL itself; this covers .quit,
# Ctrl-D, and every other way out. Running it on EXIT rather than after the
# command means a SIGTERM to the launcher is covered too.
#
# --dark-mode / --light-mode are passed straight through, and are the answer to
# a prompt that draws and then ignores everything typed at it. To pick its
# colours, DuckDB's shell asks the terminal for its background (OSC 11) and for
# its device attributes, then waits for the replies -- and until they arrive or
# it gives up, the keyboard does nothing. Against a terminal that never answers,
# measured at 5.02s every time before the prompt became usable, and 0.01s with
# either colour pinned. It is DuckDB's shell, not harbor: plain duckdb stalls
# identically.
if [[ "$mode" == "repl" ]]; then
  trap 'duckdb -no-init "$db" -c "CHECKPOINT" >/dev/null 2>&1 || true' EXIT
  status=0
  duckdb -unsigned -no-init ${colormode:+"-$colormode"} "$db" -cmd "$setup" || status=$?
  exit $status
fi

# CHECKPOINT comes after harbor_wait, and it has to. While harbor_wait is
# blocked it is a running query, and a running query is an open transaction
# older than every write the server has served — DuckDB refuses to CHECKPOINT
# with one of those outstanding, and FORCE CHECKPOINT waits for a transaction
# that by definition never finishes. Once harbor_wait returns, the workers are
# stopped and nothing else is in flight, so the WAL folds cleanly.
exec duckdb -unsigned -no-init "$db" -c "
  $setup
  CALL harbor_wait();
  CHECKPOINT;
"
